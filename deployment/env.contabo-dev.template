# ============================================================
# Inspect360 - Contabo DEV portal env template (dev.inspect360.ai)
# Copy to /opt/inspect360-dev/.env on the server (NEVER commit real values)
# Template: deployment/env.contabo-dev.template
# ============================================================

NODE_ENV=production
PORT=5000
HOST=0.0.0.0
RUNNING_IN_DOCKER=true
BASE_URL=https://dev.inspect360.ai
CORS_ORIGINS=https://dev.inspect360.ai

# Separate DB from production. Host MUST be `postgres` inside Docker.
# On Contabo: role creativecloud owns inspect360_dev
DATABASE_URL=postgresql://creativecloud:YOUR_DB_PASSWORD@postgres:5432/inspect360_dev

# Generate: openssl rand -hex 32 (must differ from production)
SESSION_SECRET=YOUR_64_CHARACTER_RANDOM_STRING_HERE

LOCAL_STORAGE_DIR=/app/storage
PRIVATE_OBJECT_DIR=private
PUBLIC_OBJECT_SEARCH_PATHS=public

# Stripe TEST mode only (not live)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com

AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=sk-...

GOOGLE_MAPS_API_KEY=

ENABLE_MONTHLY_RESET_SCHEDULER=true
