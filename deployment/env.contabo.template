# ============================================================
# Inspect360 - Contabo / Caddy production env template
# Copy this file to /opt/inspect360/.env on the server (NEVER commit real values)
# Template: deployment/env.contabo.template
# ============================================================

NODE_ENV=production
PORT=5000
HOST=0.0.0.0
RUNNING_IN_DOCKER=true
BASE_URL=https://portal.inspect360.ai
CORS_ORIGINS=https://portal.inspect360.ai

# Host MUST be `postgres` inside Docker (not localhost)
DATABASE_URL=postgresql://inspect360:YOUR_DB_PASSWORD@postgres:5432/inspect360

# Generate: openssl rand -hex 32
SESSION_SECRET=YOUR_64_CHARACTER_RANDOM_STRING_HERE

LOCAL_STORAGE_DIR=/app/storage
PRIVATE_OBJECT_DIR=private
PUBLIC_OBJECT_SEARCH_PATHS=public

STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com

# TextMagic SMS (tenant notifications). Keep credentials server-side only.
TEXTMAGIC_USERNAME=
TEXTMAGIC_API_KEY=
TEXTMAGIC_FROM=
TEXTMAGIC_ENABLED=false

AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=sk-...
# Model ids — change without code deploy. Defaults match current behaviour.
AI_INSPECTION_MODEL=gpt-5
AI_CHAT_MODEL=gpt-4o
AI_CHAT_MINI_MODEL=gpt-4o-mini
AI_WHISPER_MODEL=whisper-1
AI_IMAGE_MODEL=dall-e-3

GOOGLE_MAPS_API_KEY=

# Admin-managed credits: leave false so credits do not auto-expire / auto-renew monthly.
# Only set true for legacy Stripe subscription quota reset behavior.
ENABLE_MONTHLY_RESET_SCHEDULER=false
ADMIN_MANAGED_CREDITS=true

# Reapit Foundations (one-way sync). Generate encryption key: openssl rand -hex 32
REAPIT_CLIENT_ID=
REAPIT_CLIENT_SECRET=
REAPIT_CONNECT_URL=https://connect.reapit.cloud
REAPIT_API_URL=https://platform.reapit.cloud
REAPIT_REDIRECT_URI=https://portal.inspect360.ai/api/reapit/oauth/callback
INTEGRATION_ENCRYPTION_KEY=
ENABLE_REAPIT_WORKER=true

